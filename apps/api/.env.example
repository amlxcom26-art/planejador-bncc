NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Conexão PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://planejador:planejador_dev@localhost:5432/planejador_bncc?schema=public

# Chaves de Autenticação JWT (valores locais para desenvolvimento)
JWT_ACCESS_SECRET=dev_access_token_secret_key_change_in_production
JWT_REFRESH_SECRET=dev_refresh_token_secret_key_change_in_production

# Integração n8n (Ativado em mock mode para desenvolvimento offline)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/gerar-plano-bncc
N8N_API_KEY=dev_n8n_api_key_test_token
N8N_MOCK_MODE=true
